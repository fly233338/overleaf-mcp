{
  "name": "@fly233338/overleaf-mcp",
  "version": "1.2.1",
  "description": "MCP server for reading and editing Overleaf projects through Git.",
  "type": "module",
  "exports": {
    "./bin": "./dist/bin.js"
  },
  "bin": {
    "overleaf-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^7.0.2",
    "vitest": "3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "fly233338",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "overleaf",
    "latex"
  ],
  "license": "MIT"
}
